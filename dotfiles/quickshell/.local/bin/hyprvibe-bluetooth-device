#!/bin/bash

# hyprvibe:summary=Control a Bluetooth device
# hyprvibe:group=bluetooth
# hyprvibe:args=[pair|connect|disconnect|forget] <address>
# hyprvibe:examples=hyprvibe bluetooth device connect 00:11:22:33:44:55

set -e

usage() {
  echo "Usage: hyprvibe-bluetooth-device [scan|pair|connect|disconnect|forget] [address]" >&2
  exit 1
}

action=${1:-}
address=${2:-}

[[ $action == "scan" || $action == "pair" || $action == "connect" || $action == "disconnect" || $action == "forget" ]] || usage
if [[ $action != "scan" ]]; then
  [[ $address =~ ^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$ ]] || usage
fi

power_on() {
  local info
  info="$(timeout 2s bluetoothctl show 2>/dev/null || true)"
  if [[ "$info" == *"Powered: yes"* ]]; then
    return 0
  fi
  # Not bluetoothctl directly: Bluetooth is turned off by an rfkill soft block,
  # and BlueZ refuses to power an adapter up while one is set.
  hyprvibe-bluetooth-power on || return 1
}

trust_device() {
  bluetoothctl trust "$address" >/dev/null 2>&1 || true
}

case "$action" in
  scan)
    power_on
    timeout 5s bluetoothctl scan on >/dev/null 2>&1 || true
    ;;
  pair)
    power_on
    if command -v hyprvibe-bluetooth-pair >/dev/null 2>&1; then
      hyprvibe-bluetooth-pair "$address"
    else
      timeout 20s bluetoothctl --agent NoInputNoOutput pair "$address" >/dev/null 2>&1
    fi
    trust_device
    timeout 20s bluetoothctl connect "$address" >/dev/null 2>&1
    ;;
  connect)
    power_on
    trust_device
    timeout 20s bluetoothctl connect "$address" >/dev/null 2>&1
    ;;
  disconnect)
    timeout 10s bluetoothctl disconnect "$address" >/dev/null 2>&1
    ;;
  forget)
    power_on
    timeout 10s bluetoothctl disconnect "$address" >/dev/null 2>&1 || true
    timeout 10s bluetoothctl remove "$address" >/dev/null 2>&1
    ;;
esac
