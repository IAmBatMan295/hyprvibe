#!/usr/bin/env bash

# HyprVibe Theme Dispatcher CLI
# Manages active theme state and renders dynamic component configs

set -euo pipefail

REAL_SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd -- "$(dirname -- "${REAL_SCRIPT}")" && pwd)"
ROOT_DIR="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
THEME_LIB="${SCRIPT_DIR}/lib/theme-engine.sh"

if [[ ! -r "$THEME_LIB" ]]; then
    echo "Error: Missing theme engine library: $THEME_LIB" >&2
    exit 1
fi

# shellcheck disable=SC1090
source "$THEME_LIB"

THEMES_DIR="${THEMES_DIR:-${ROOT_DIR}/themes}"
USER_THEMES_DIR="${USER_THEMES_DIR:-${HOME}/.config/hyprvibe/themes}"
TEMPLATES_DIR="${TEMPLATES_DIR:-${ROOT_DIR}/templates/themed}"
STATE_DIR="${STATE_DIR:-${HOME}/.local/state/hyprvibe/current}"
SDDM_THEME_DIR="${SDDM_THEME_DIR:-/usr/share/sddm/themes/hyprvibe}"
REPO_SDDM_DIR="${REPO_SDDM_DIR:-${ROOT_DIR}/dotfiles/sddm/themes/hyprvibe}"
LOCK_FILE="${XDG_RUNTIME_DIR:-/tmp}/hyprvibe-theme-${UID}.lock"

usage() {
    cat << EOF
Usage: hyprvibe-theme <command> [arguments]

Commands:
  list                 List all available themes
  current              Show currently active theme name
  get <color_key>      Print resolved color value for active theme
  set <theme_name>     Apply specified theme across all components
  help                 Show this help message
EOF
}

cmd_list() {
    local -A seen=()
    local dir tname

    for dir in "$THEMES_DIR" "$USER_THEMES_DIR"; do
        if [[ -d "$dir" ]]; then
            for theme_path in "$dir"/*; do
                if [[ -d "$theme_path" && -f "$theme_path/colors.toml" ]]; then
                    tname="$(basename "$theme_path")"
                    if [[ -z "${seen[$tname]:-}" ]]; then
                        echo "$tname"
                        seen["$tname"]=1
                    fi
                fi
            done
        fi
    done
}

cmd_current() {
    if [[ -f "${STATE_DIR}/theme.name" ]]; then
        cat "${STATE_DIR}/theme.name"
    else
        echo "monochrome"
    fi
}

cmd_get() {
    local key="${1:-}"
    if [[ -z "$key" ]]; then
        echo "Error: Key required. Usage: hyprvibe-theme get <color_key>" >&2
        return 1
    fi

    local current_colors="${STATE_DIR}/colors.toml"
    if [[ ! -f "$current_colors" ]]; then
        local current_theme
        current_theme="$(cmd_current)"
        current_colors="${THEMES_DIR}/${current_theme}/colors.toml"
    fi

    if [[ -f "$current_colors" ]]; then
        load_colors_file "$current_colors"
        get_theme_color "$key"
    else
        echo "Error: No active colors file found" >&2
        return 1
    fi
}

resolve_theme_target() {
    local query="$1"
    local norm_q dir candidate cname norm_c
    # 1. Exact directory match first (preserves underscores like tokyo_night)
    for dir in "$USER_THEMES_DIR" "$THEMES_DIR"; do
        if [[ -d "${dir}/${query}" && -f "${dir}/${query}/colors.toml" ]]; then
            printf '%s\t%s\n' "$query" "${dir}/${query}"
            return 0
        fi
    done

    # 2. Case/separator-normalized match (handles "Tokyo Night" -> "tokyo_night" or "forest-green")
    norm_q="$(printf '%s' "$query" | tr '[:upper:]' '[:lower:]' | tr ' _' '--')"
    for dir in "$USER_THEMES_DIR" "$THEMES_DIR"; do
        [[ -d "$dir" ]] || continue
        for candidate in "$dir"/*; do
            [[ -d "$candidate" && -f "${candidate}/colors.toml" ]] || continue
            cname="$(basename "$candidate")"
            norm_c="$(printf '%s' "$cname" | tr '[:upper:]' '[:lower:]' | tr ' _' '--')"
            if [[ "$norm_c" == "$norm_q" ]]; then
                printf '%s\t%s\n' "$cname" "$candidate"
                return 0
            fi
        done
    done
    return 1
}

sync_sddm_target() {
    local target_root="$1"
    local bg_src="$2"
    local accent="$3" bg_col="$4" fg_col="$5" muted="$6" err_col="$7" border_col="$8"
    [[ -d "$target_root" ]] || return 0

    local bg_name="default-bg.jpg"
    local assets_dir="${target_root}/assets"
    if [[ -n "$bg_src" && -f "$bg_src" ]]; then
        local ext="${bg_src##*.}"
        ext="${ext,,}"
        [[ "$ext" == "jpeg" || "$ext" == "jpg" || "$ext" == "png" || "$ext" == "webp" ]] || ext="jpg"
        bg_name="default-bg.${ext}"
        [[ -d "$assets_dir" || ! -w "$target_root" ]] || mkdir -p "$assets_dir" 2>/dev/null || true
        if [[ -d "$assets_dir" && -w "$assets_dir" ]]; then
            chmod 755 "$assets_dir" 2>/dev/null || true
            local tmp_bg
            tmp_bg="$(mktemp "${assets_dir}/.bg.XXXXXX")"
            if cp -f "$bg_src" "$tmp_bg" 2>/dev/null; then
                chmod 644 "$tmp_bg" 2>/dev/null || true
                rm -f "${assets_dir}"/default-bg.* 2>/dev/null || true
                mv -f "$tmp_bg" "${assets_dir}/${bg_name}" 2>/dev/null || rm -f "$tmp_bg"
            else
                rm -f "$tmp_bg"
            fi
        fi
    elif [[ -d "$assets_dir" ]]; then
        local existing_bg
        shopt -s nullglob
        for existing_bg in "${assets_dir}"/default-bg.*; do
            bg_name="$(basename "$existing_bg")"
            break
        done
        shopt -u nullglob
    fi

    local conf_path="${target_root}/theme.conf"
    local conf_body="[General]
background=assets/${bg_name}
blurRadius=50
accentColor=${accent}
surfaceColor=${bg_col}
textColor=${fg_col}
mutedColor=${muted}
errorColor=${err_col}
borderColor=${border_col}
fontFamily=JetBrainsMono Nerd Font
fontSize=13"

    if [[ -w "$target_root" ]]; then
        local tmp_conf
        tmp_conf="$(mktemp "${target_root}/.theme.conf.XXXXXX" 2>/dev/null || true)"
        if [[ -n "$tmp_conf" ]]; then
            printf '%s\n' "$conf_body" > "$tmp_conf"
            chmod 644 "$tmp_conf" 2>/dev/null || true
            mv -f "$tmp_conf" "$conf_path" 2>/dev/null || rm -f "$tmp_conf"
        fi
    elif [[ -w "$conf_path" ]]; then
        printf '%s\n' "$conf_body" > "$conf_path" 2>/dev/null || true
        chmod 644 "$conf_path" 2>/dev/null || true
    fi
}

cmd_set() {
    local requested_name="${1:-}"
    if [[ -z "$requested_name" ]]; then
        echo "Error: Theme name required. Usage: hyprvibe-theme set <theme_name>" >&2
        return 1
    fi

    local resolved="" theme_name="" target_dir=""
    if ! resolved="$(resolve_theme_target "$requested_name")"; then
        echo "Error: Theme '$requested_name' does not exist." >&2
        return 1
    fi
    IFS=$'\t' read -r theme_name target_dir <<<"$resolved"

    # Acquire lock to prevent concurrent writes
    exec 9>"$LOCK_FILE"
    flock 9

    mkdir -p "$STATE_DIR"

    # Load palette & atomically render dynamic templates into STATE_DIR
    load_colors_file "${target_dir}/colors.toml"
    render_all_templates "$TEMPLATES_DIR" "$STATE_DIR"

    # Merge optional per-theme shell.overrides.toml onto rendered shell.toml
    if [[ -f "${target_dir}/shell.overrides.toml" && -f "${STATE_DIR}/shell.toml" ]]; then
        local tmp_shell
        tmp_shell="$(mktemp "${STATE_DIR}/.shell.toml.XXXXXX")"
        {
            cat "${STATE_DIR}/shell.toml"
            printf '\n'
            cat "${target_dir}/shell.overrides.toml"
        } > "$tmp_shell"
        chmod 644 "$tmp_shell" 2>/dev/null || true
        mv -f "$tmp_shell" "${STATE_DIR}/shell.toml"
    fi

    # Atomically update colors.toml & theme.name (keeps file watchers consistent)
    local tmp_colors tmp_name
    tmp_colors="$(mktemp "${STATE_DIR}/.colors.toml.XXXXXX")"
    cp "${target_dir}/colors.toml" "$tmp_colors"
    chmod 644 "$tmp_colors" 2>/dev/null || true
    mv -f "$tmp_colors" "${STATE_DIR}/colors.toml"

    tmp_name="$(mktemp "${STATE_DIR}/.theme.name.XXXXXX")"
    printf '%s\n' "$theme_name" > "$tmp_name"
    chmod 644 "$tmp_name" 2>/dev/null || true
    mv -f "$tmp_name" "${STATE_DIR}/theme.name"
    ln -sfn "$target_dir" "${STATE_DIR}/theme"

    # Sync theme backgrounds as symlinks to ~/Pictures/Current-Wallpapers & signal wallpaper-changer.sh
    local wall_dir="${USER_HOME:-$HOME}/Pictures/Current-Wallpapers"
    if [[ -d "${target_dir}/backgrounds" ]]; then
        shopt -s nullglob
        local bgs=("${target_dir}/backgrounds"/*.{jpg,jpeg,png,webp})
        shopt -u nullglob
        if (( ${#bgs[@]} > 0 )); then
            mkdir -p "$wall_dir"
            find "$wall_dir" -maxdepth 1 \( -type f -o -type l \) -delete
            local bg
            for bg in "${bgs[@]}"; do
                ln -sfn "$bg" "${wall_dir}/$(basename "$bg")"
            done
            local changer_script="${USER_HOME:-$HOME}/.config/hypr/scripts/wallpaper-changer.sh"
            local pid_file="${WALLPAPER_PID_FILE:-${XDG_RUNTIME_DIR:-/tmp}/hyprvibe-wallpaper-changer.pid}"
            local wp_pid=""
            if [[ -r "$pid_file" ]]; then
                wp_pid="$(<"$pid_file")"
                if [[ -z "$wp_pid" || ! "$wp_pid" =~ ^[0-9]+$ ]] || ! kill -0 "$wp_pid" 2>/dev/null; then
                    wp_pid=""
                fi
            fi
            if [[ -z "$wp_pid" ]]; then
                wp_pid="$(pgrep -f '(^|/)wallpaper-changer\.sh([[:space:]]|$)' 2>/dev/null | head -n 1 || true)"
            fi

            local need_start=0
            if [[ -n "$wp_pid" ]]; then
                if [[ -x "$changer_script" && -e "/proc/${wp_pid}" && "$changer_script" -nt "/proc/${wp_pid}" ]]; then
                    kill -TERM "$wp_pid" 2>/dev/null || true
                    local wait_i
                    for ((wait_i = 0; wait_i < 20; wait_i++)); do
                        kill -0 "$wp_pid" 2>/dev/null || break
                        sleep 0.05
                    done
                    need_start=1
                else
                    kill -SIGUSR1 "$wp_pid" 2>/dev/null || true
                fi
            elif [[ -x "$changer_script" ]] && command -v awww >/dev/null 2>&1 && pgrep -x Hyprland >/dev/null 2>&1; then
                need_start=1
            fi

            if (( need_start == 1 )); then
                if command -v setsid >/dev/null 2>&1; then
                    setsid -f "$changer_script" 9>&- </dev/null >/dev/null 2>&1
                else
                    "$changer_script" 9>&- </dev/null >/dev/null 2>&1 &
                fi
            elif command -v awww >/dev/null 2>&1 && pgrep -x Hyprland >/dev/null 2>&1; then
                if ! pgrep -x awww-daemon >/dev/null 2>&1; then
                    awww-daemon >/dev/null 2>&1 &
                    sleep 0.1
                fi
                local rate="60"
                if command -v hyprctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
                    rate=$(hyprctl monitors -j 2>/dev/null | jq -r '(([.[] | select(.focused == true)] | .[0]) // .[0] // empty) | .refreshRate // 60 | floor' 2>/dev/null || echo "60")
                fi
                awww img "${bgs[0]}" --transition-type random --transition-duration 1.2 --transition-fps "${rate:-60}" --resize crop >/dev/null 2>&1 || true
            fi
        fi
    fi

    # Sync SDDM theme background and colors (preserving actual image extension)
    local sddm_bg=""
    if [[ -d "${target_dir}/backgrounds" ]]; then
        shopt -s nullglob
        local sddm_bgs=("${target_dir}/backgrounds"/*.{jpg,jpeg,png,webp})
        shopt -u nullglob
        if (( ${#sddm_bgs[@]} > 0 )); then
            sddm_bg="${sddm_bgs[$((RANDOM % ${#sddm_bgs[@]}))]}"
        fi
    fi

    local sddm_accent sddm_bg_col sddm_fg_col sddm_muted sddm_error sddm_border
    sddm_accent="$(get_theme_color "accent" "#a1a0fa")"
    sddm_bg_col="$(get_theme_color "background" "#1e1e2e")"
    sddm_fg_col="$(get_theme_color "foreground" "#cdd6f4")"
    sddm_muted="$(get_theme_color "muted" "#9795c4")"
    sddm_error="$(get_theme_color "red" "#f38ba8")"
    sddm_border="$(get_theme_color "selection" "#45475a")"

    sync_sddm_target "$REPO_SDDM_DIR" "$sddm_bg" "$sddm_accent" "$sddm_bg_col" "$sddm_fg_col" "$sddm_muted" "$sddm_error" "$sddm_border"
    sync_sddm_target "$SDDM_THEME_DIR" "$sddm_bg" "$sddm_accent" "$sddm_bg_col" "$sddm_fg_col" "$sddm_muted" "$sddm_error" "$sddm_border"

    # GTK / GSettings retint (if desktop session active)
    if command -v gsettings >/dev/null 2>&1 && [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
        local mode
        mode="$(get_theme_color "mode" "dark")"
        if [[ "$mode" == "light" ]]; then
            gsettings set org.gnome.desktop.interface color-scheme "prefer-light" 2>/dev/null || true
            gsettings set org.gnome.desktop.interface gtk-theme "adw-gtk3" 2>/dev/null || true
        else
            gsettings set org.gnome.desktop.interface color-scheme "prefer-dark" 2>/dev/null || true
            gsettings set org.gnome.desktop.interface gtk-theme "adw-gtk3-dark" 2>/dev/null || true
        fi

        local icon_file="${target_dir}/icons.theme"
        if [[ -f "$icon_file" && -s "$icon_file" ]]; then
            local icon_theme
            icon_theme="$(<"$icon_file")"
            icon_theme="${icon_theme//[[:space:]]/}"
            if [[ -n "$icon_theme" ]]; then
                gsettings set org.gnome.desktop.interface icon-theme "$icon_theme" 2>/dev/null || true
            fi
        fi
    fi

    # Push theme cleanly to running Quickshell once
    if command -v quickshell >/dev/null 2>&1 && pgrep -x quickshell >/dev/null 2>&1 && command -v base64 >/dev/null 2>&1; then
        local colors_b64="" shell_b64=""
        [[ -f "${STATE_DIR}/colors.toml" ]] && colors_b64="$(base64 -w0 "${STATE_DIR}/colors.toml" 2>/dev/null || true)"
        [[ -f "${STATE_DIR}/shell.toml" ]] && shell_b64="$(base64 -w0 "${STATE_DIR}/shell.toml" 2>/dev/null || true)"
        quickshell ipc call shell applyTheme "$colors_b64" "$shell_b64" >/dev/null 2>&1 || true
    fi

    # Reload desktop components
    if command -v hyprctl >/dev/null 2>&1 && pgrep -x Hyprland >/dev/null 2>&1; then
        hyprctl reload >/dev/null 2>&1 &
    fi

    if command -v dunstctl >/dev/null 2>&1 && pgrep -x dunst >/dev/null 2>&1; then
        dunstctl reload >/dev/null 2>&1 &
    fi

    if command -v tmux >/dev/null 2>&1 && pgrep -x tmux >/dev/null 2>&1; then
        tmux source-file "${STATE_DIR}/tmux.conf" 2>/dev/null || true
    fi

    # Reload active Neovim instances (theme-sync guards against double reload via disk_theme check)
    if command -v nvim >/dev/null 2>&1 && pgrep -x nvim >/dev/null 2>&1; then
        shopt -s nullglob
        local sock
        for sock in "${XDG_RUNTIME_DIR:-/tmp}"/nvim.*.0 "${XDG_RUNTIME_DIR:-/tmp}"/nvim* /tmp/nvim*/0; do
            if [[ -S "$sock" ]]; then
                timeout 1 nvim --server "$sock" --remote-send '<Cmd>doautocmd FocusGained<CR>' 2>/dev/null || true
            fi
        done
        shopt -u nullglob
    fi

    flock -u 9
    echo "Theme '$theme_name' applied successfully."
}

format_theme_title() {
    local name="$1"
    local spaced="${name//[-_]/ }"
    awk '{for(i=1;i<=NF;i++) $i=toupper(substr($i,1,1)) tolower(substr($i,2))}1' <<< "$spaced"
}

cmd_menu() {
    local raw_themes
    raw_themes="$(cmd_list)"
    local current
    current="$(cmd_current)"

    local c_active c_dim
    c_active="$(cmd_get foreground 2>/dev/null || echo '#ffffff')"
    c_dim="$(cmd_get muted 2>/dev/null || echo '#8e8e8e')"

    local display_themes=""
    local -A TITLE_TO_SLUG=()
    local line
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        local title
        title="$(format_theme_title "$line")"
        TITLE_TO_SLUG["$title"]="$line"
        local row_color="$c_dim"
        if [[ "$line" == "$current" ]]; then
            row_color="$c_active"
        fi
        local row="<span color=\"${row_color}\">${title}</span>"
        if [[ -z "$display_themes" ]]; then
            display_themes="$row"
        else
            display_themes="${display_themes}"$'\n'"${row}"
        fi
    done <<< "$raw_themes"

    local current_title
    current_title="$(format_theme_title "$current")"

    local selected=""
    selected=$(printf '%s\n' "$display_themes" | hyprvibe-dmenu -dmenu --preset theme -markup-rows -p "Theme" -select "$current_title" 2>/dev/null || true)

    # Strip any Pango markup tags from selection and map title directly back to directory slug
    selected=$(printf '%s' "$selected" | sed -E 's/<[^>]*>//g')

    if [[ -n "$selected" ]]; then
        local resolved_slug="${TITLE_TO_SLUG[$selected]:-$selected}"
        cmd_set "$resolved_slug"
    fi
}

main() {
    local cmd="${1:-}"
    shift || true

    case "$cmd" in
        list)
            cmd_list "$@"
            ;;
        current)
            cmd_current "$@"
            ;;
        get)
            cmd_get "$@"
            ;;
        set)
            cmd_set "$@"
            ;;
        menu)
            cmd_menu "$@"
            ;;
        help|--help|-h|"")
            usage
            ;;
        *)
            echo "Unknown command: $cmd" >&2
            usage >&2
            exit 1
            ;;
    esac
}

main "$@"
